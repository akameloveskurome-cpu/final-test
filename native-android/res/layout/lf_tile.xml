<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lft_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/lf_widget_bg" android:orientation="vertical" android:gravity="center" android:padding="8dp">
    <ImageView android:id="@+id/lft_icon" android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="@null"/>
    <TextView android:id="@+id/lft_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:singleLine="true" android:textColor="@color/lf_white" android:textSize="13sp" android:textStyle="bold"/>
</LinearLayout>
