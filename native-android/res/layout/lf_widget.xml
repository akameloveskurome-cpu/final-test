<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lfw_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/lf_widget_bg" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
    <LinearLayout android:id="@+id/lfw_open" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/lfw_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="@color/lf_white" android:textSize="15sp" android:textStyle="bold"/>
        <TextView android:id="@+id/lfw_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="@color/lf_red" android:textSize="12sp"/>
    </LinearLayout>
    <ImageButton android:id="@+id/lfw_prev" android:layout_width="40dp" android:layout_height="40dp" android:background="@null" android:src="@drawable/lf_w_prev" android:contentDescription="Previous"/>
    <ImageButton android:id="@+id/lfw_play" android:layout_width="44dp" android:layout_height="44dp" android:background="@null" android:src="@drawable/lf_w_play" android:contentDescription="Play or pause"/>
    <ImageButton android:id="@+id/lfw_next" android:layout_width="40dp" android:layout_height="40dp" android:background="@null" android:src="@drawable/lf_w_next" android:contentDescription="Next"/>
</LinearLayout>
