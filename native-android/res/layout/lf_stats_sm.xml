<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/lfs_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/lf_widget_bg" android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/lfs_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:textColor="@color/lf_red" android:textSize="12sp" android:textStyle="bold" android:paddingBottom="4dp"/>
    <TextView android:id="@+id/lfs_big" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="@color/lf_white" android:textSize="22sp" android:textStyle="bold"/>
    <TextView android:id="@+id/lfs_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="@color/lf_white_70" android:textSize="12sp"/>
    <TextView android:id="@+id/lfs_top" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="bottom" android:singleLine="true" android:ellipsize="end" android:textColor="@color/lf_white" android:textSize="12sp"/>
    <ProgressBar android:id="@+id/lfs_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp" android:max="100" android:progress="50" android:indeterminate="false" android:progressDrawable="@drawable/lf_w_bar"/>
    <TextView android:id="@+id/lfs_dn" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="@color/lf_white_70" android:textSize="11sp" android:paddingTop="3dp"/>
</LinearLayout>
