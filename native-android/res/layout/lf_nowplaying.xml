<?xml version="1.0" encoding="utf-8"?>
<!-- v148: large Now Playing widget. The service pushes title / artist / album / cover path (LiquidWidget.push); the buttons use the same broadcasts as the small widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lfn_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/lf_widget_bg" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
    <ImageView android:id="@+id/lfn_cover" android:layout_width="88dp" android:layout_height="88dp" android:scaleType="centerCrop" android:contentDescription="Album cover"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:layout_marginLeft="12dp" android:layout_marginStart="12dp">
        <LinearLayout android:id="@+id/lfn_info" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
            <TextView android:id="@+id/lfn_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="@color/lf_white" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/lfn_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="@color/lf_red" android:textSize="13sp"/>
            <TextView android:id="@+id/lfn_album" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="@color/lf_white_70" android:textSize="11sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageButton android:id="@+id/lfn_prev" android:layout_width="40dp" android:layout_height="40dp" android:background="@null" android:src="@drawable/lf_w_prev" android:contentDescription="Previous"/>
            <ImageButton android:id="@+id/lfn_play" android:layout_width="44dp" android:layout_height="44dp" android:background="@null" android:src="@drawable/lf_w_play" android:contentDescription="Play or pause"/>
            <ImageButton android:id="@+id/lfn_next" android:layout_width="40dp" android:layout_height="40dp" android:background="@null" android:src="@drawable/lf_w_next" android:contentDescription="Next"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
