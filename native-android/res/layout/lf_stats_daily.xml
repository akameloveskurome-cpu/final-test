<?xml version="1.0" encoding="utf-8"?>
<!-- v148: Listening: Daily widget. Today's total, comparison with yesterday, songs / unique songs / artists, a 24-hour chart, top artist and song, day / night split. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/lfs_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/lf_widget_bg" android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/lfs_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:textColor="@color/lf_red" android:textSize="12sp" android:textStyle="bold" android:paddingBottom="2dp"/>
    <TextView android:id="@+id/lfs_big" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="@color/lf_white" android:textSize="22sp" android:textStyle="bold"/>
    <TextView android:id="@+id/lfs_vs" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="@color/lf_white_70" android:textSize="12sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="6dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/lfs_a" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="@color/lf_white" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/lfs_al" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="@color/lf_white_70" android:textSize="11sp" android:text="@string/lf_w_songs_played"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/lfs_b" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="@color/lf_white" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/lfs_bl" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="@color/lf_white_70" android:textSize="11sp" android:text="@string/lf_w_unique_songs"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/lfs_c" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="@color/lf_white" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/lfs_cl" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="@color/lf_white_70" android:textSize="11sp" android:text="@string/lf_w_artists"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/lfs_chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:scaleType="fitXY" android:contentDescription="Listening today, hour by hour"/>
    <TextView android:id="@+id/lfs_t1" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="@color/lf_white" android:textSize="12sp" android:paddingTop="4dp"/>
    <TextView android:id="@+id/lfs_t2" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="@color/lf_white" android:textSize="12sp"/>
    <ProgressBar android:id="@+id/lfs_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp" android:max="100" android:progress="50" android:indeterminate="false" android:progressDrawable="@drawable/lf_w_bar"/>
    <TextView android:id="@+id/lfs_dn" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="@color/lf_white_70" android:textSize="11sp" android:paddingTop="3dp"/>
</LinearLayout>
